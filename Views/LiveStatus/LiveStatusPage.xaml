<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCMAUI.Views.LiveStatus.LiveStatusPage"
             Title="Live Status">
    <CollectionView x:Name="TeamCollection" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,6" CornerRadius="10" Padding="16">
                    <HorizontalStackLayout Spacing="12">
                        <Frame WidthRequest="48" HeightRequest="48" CornerRadius="24" BackgroundColor="#6C63FF" Padding="0">
                            <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Text="{Binding CurrentActivity}" TextColor="Gray" FontSize="12"/>
                            <Label Text="{Binding Status}" TextColor="#43C59E" FontSize="12"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
