<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCMAUI.Views.Activity.ActivityPage"
             Title="Activity">
    <CollectionView x:Name="ActivityCollection" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,6" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Title}" FontAttributes="Bold"/>
                            <Label Text="{Binding Type}" TextColor="#6C63FF" FontSize="12"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Duration}" TextColor="Gray" VerticalOptions="Center"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
