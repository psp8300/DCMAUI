<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCMAUI.Views.Workday.WorkdayPage"
             Title="Workday">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Frame BackgroundColor="#6C63FF" CornerRadius="16" Padding="24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Today's Session" TextColor="White" HorizontalOptions="Center"/>
                    <Label x:Name="ElapsedLabel" Text="00:00:00" FontSize="40" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label x:Name="StatusLabel" Text="Working" TextColor="White" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Frame CornerRadius="12" Padding="16">
                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Start Time" TextColor="Gray" FontSize="12"/>
                        <Label x:Name="StartTimeLabel" Text="--:--" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Earnings" TextColor="Gray" FontSize="12"/>
                        <Label x:Name="EarningsLabel" Text="₹0" FontAttributes="Bold" TextColor="#43C59E"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
