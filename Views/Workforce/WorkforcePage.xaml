<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCMAUI.Views.Workforce.WorkforcePage"
             Title="Workforce">
    <CollectionView x:Name="WorkforceCollection" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,6" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#FF6584" Padding="0">
                            <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Text="{Binding Status}" TextColor="Gray" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
