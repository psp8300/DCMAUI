<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCMAUI.Views.Schedule.SchedulePage"
             Title="Schedule">
    <CollectionView x:Name="ScheduleCollection" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,6" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0" WidthRequest="4" BackgroundColor="#6C63FF" CornerRadius="2" Margin="0,0,12,0"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding Title}" FontAttributes="Bold"/>
                            <Label Text="{Binding Type}" TextColor="#6C63FF" FontSize="12"/>
                            <Label Text="{Binding Time}" TextColor="Gray" FontSize="12"/>
                            <Label Text="{Binding Location}" TextColor="Gray" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
